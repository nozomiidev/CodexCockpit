{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-cockpit.dev/schemas/v1/command-envelope.schema.json",
  "title": "CodexCockpit command envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commandId",
    "sessionId",
    "correlationId",
    "actor",
    "type",
    "sentAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commandId": {
      "type": "string",
      "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor": { "$ref": "#/$defs/actor" },
    "type": { "type": "string", "pattern": "^[a-z]+(?:\\.[a-z]+)+$" },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "payload": { "type": "object" }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "enum": ["workspace-player", "model-player", "system"] },
        "playerId": {
          "type": "string",
          "pattern": "^ply_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  }
}
