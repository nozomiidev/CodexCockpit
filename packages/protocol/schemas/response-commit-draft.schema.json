{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-cockpit.dev/schemas/v1/response-commit-draft.schema.json",
  "title": "Gateway response commit draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["output"],
  "properties": {
    "output": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [{ "$ref": "#/$defs/message" }, { "$ref": "#/$defs/functionCall" }]
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "pattern": "\\S" },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "type": { "const": "message" },
        "role": { "const": "assistant" },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "output_text" },
              "text": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        }
      }
    },
    "functionCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "call_id", "name", "arguments"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "type": { "const": "function_call" },
        "call_id": { "$ref": "#/$defs/nonEmpty" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "arguments": {
          "type": "string",
          "minLength": 2,
          "contentMediaType": "application/json",
          "contentSchema": { "type": "object" }
        }
      }
    }
  }
}
